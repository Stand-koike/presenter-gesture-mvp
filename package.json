{
  "name": "presenter-gesture-mvp",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "setup:models": "node scripts/download-hand-landmarker.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "electron": "^37.0.0",
    "pdfjs-dist": "^5.4.54",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "wait-on": "^8.0.3"
  }
}
